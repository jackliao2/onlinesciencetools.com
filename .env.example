# Public site URL (optional; defaults to https://onlinesciencetools.com)
# NEXT_PUBLIC_SITE_URL=https://onlinesciencetools.com

# Contact email shown on /contact
# NEXT_PUBLIC_CONTACT_EMAIL=contact@onlinesciencetools.com

# Volcengine Ark image generation (scripts/generate-content-images.mts)
# ARK_API_KEY=
# ARK_IMAGE_ENDPOINT=ep-xxxxxxxx
# ARK_IMAGE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
